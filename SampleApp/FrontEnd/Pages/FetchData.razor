@page "/"
@using FrontEnd.Data
@inject WeatherForecastClient ForecastClient
@inject IJSRuntime JSRuntime

<PageTitle>Weather forecast</PageTitle>

<h1>Weather forecast</h1>

<p>This component demonstrates fetching data from a service.</p>

@if (forecasts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Temp. (C)</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in forecasts)
            {
                <tr>
                    <td>@GetFormattedDate(forecast.Date)</td>
                    <td>@forecast.TemperatureC</td>
                    <td>@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private WeatherForecast[]? forecasts;
    private Dictionary<DateOnly, string> formattedDates = new();

    protected override async Task OnInitializedAsync()
    {
        forecasts = await ForecastClient.GetForecastAsync(DateTime.Now);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && forecasts != null)
        {
            foreach (var forecast in forecasts)
            {
                var formattedDate = await JSRuntime.InvokeAsync<string>(
                    "dateFormatter.formatDate",
                    forecast.Date.Year,
                    forecast.Date.Month,
                    forecast.Date.Day);
                formattedDates[forecast.Date] = formattedDate;
            }
            StateHasChanged();
        }
    }

    private string GetFormattedDate(DateOnly date)
    {
        return formattedDates.TryGetValue(date, out var formatted) ? formatted : date.ToString("yyyy-MM-dd");
    }
}
